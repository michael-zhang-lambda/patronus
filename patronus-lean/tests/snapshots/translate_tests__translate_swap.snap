-- generated by patronus-lean
namespace Swap

structure Swap where
	mk ::
	a : BitVec 1
	b : BitVec 1

instance : Circuit Swap where
	Init c := True ∧ c.a = 0#1 ∧ c.b = 1#1
	Trans cb ca := True ∧ ca.a = cb.b ∧ ca.b = cb.a
	Assump _ := True

def bad (c : Swap) : Prop := False ∨ (True ∧ ¬(¬((c.a = c.b))))

theorem Swap_safe (n : Nat) (hb : 0 < n) : ∀(t : List (Swap)), (∀c ∈ t, Circuit.Assump c) -> Trace t -> (∀c ∈ t, ¬(bad c)) := by sorry

end Swap
