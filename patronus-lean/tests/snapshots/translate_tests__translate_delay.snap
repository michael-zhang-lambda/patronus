import PdrLean.Trace
import PdrLean.Circuit

namespace Delay

structure Delay where
  mk ::
  reg0 : BitVec 1
  reg1 : BitVec 1

instance : Circuit Delay where
  Init c := True ∧ c.reg0 = 0#1 ∧ c.reg1 = 0#1
  Trans cb ca := True ∧ ca.reg0 = 1#1 ∧ ca.reg1 = cb.reg0
  Assump _ := True

def bad (c : Delay) : Prop := False ∨ (True ∧ ¬(¬(((c.reg0 = 0#1) ∧ (c.reg1 = 1#1)))))

theorem Delay_safe : ∀(t : List (Delay)), (∀c ∈ t, Circuit.Assump c) -> Trace t -> (∀c ∈ t, ¬(bad c)) := by sorry

end Delay
