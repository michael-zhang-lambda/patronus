-- generated by patronus-lean
namespace Overflow

structure Overflow where
	mk ::
	count : BitVec 2

instance : Circuit Overflow where
	Init c := True ∧ c.count = 2#2
	Trans cb ca := True ∧ ca.count = (cb.count + 1#2)
	Assump _ := True

def bad (c : Overflow) : Prop := False ∨ (True ∧ ¬(¬((c.count = 0#2))))

theorem Overflow_safe (n : Nat) (hb : 0 < n) : ∀(t : List (Overflow)), (∀c ∈ t, Circuit.Assump c) -> Trace t -> (∀c ∈ t, ¬(bad c)) := by sorry

end Overflow
